# Data - never commit the dataset
/data
*.jpg
*.jpeg
*.png
!docs/**/*.png
*.npz
*.h5

# Model checkpoints
*.pt
*.pth
checkpoints/

# The live demo's own two exceptions, so a fresh clone can run it without the 93 MB
# feature files: a 36 kB linear head, and eight test images (see demo/README.md).
!models/tier_a_s1_fedavg_head.pt
!demo/samples/*.png

# Results (keep the folder, not the contents)
results/*
!results/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv
venv/
*.egg-info/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# iCloud: keep heavy folders out of sync
*.nosync

# Local editor/agent tooling
.claude/
